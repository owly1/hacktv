# Emberwatch configuration — copy to .env and fill in real values.
# Never commit .env. No real secrets belong in this file.

# Token the Olympe bridge uses to write observations (required to accept ingest)
INGEST_TOKEN=

# Token the dashboard/browser uses to read data and request analysis (required)
# MUST be non-empty and different from INGEST_TOKEN.
DASHBOARD_TOKEN=

# TigerData / Timescale PostgreSQL connection string (optional; memory-only when unset)
DATABASE_URL=

# Optional file with the database CA certificate for TLS verification (keep TLS on)
PG_CA_FILE=

# Gemini API key — backend only, never exposed to the browser (optional)
GEMINI_API_KEY=

# Account-enabled Gemini model name (a value here is not proof of access)
GEMINI_MODEL=gemini-3.8-flash  # gemini-2.x retired for new keys; verified live Oct 17

# Comma-separated exact origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# Listen port (default 8787, loopback only)
PORT=8787
HOST=127.0.0.1
